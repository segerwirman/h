# ═══════════════════════════════════════════════════════════════════════════
# J.A.R.V.I.S — environment variables (copy to your shell/profile; NEVER
# commit real values). Secrets belong here, not in config.yaml.
# ═══════════════════════════════════════════════════════════════════════════

# ── Relay.app integration (Fase 5) ───────────────────────────────────────────
RELAY_ENABLED=1
# Shared secret the Relay HTTP step sends in header X-Relay-Token
# (or as HMAC in X-Relay-Signature: sha256=<hex>). Required for the webhook.
RELAY_WEBHOOK_SECRET=
RELAY_WEBHOOK_HOST=127.0.0.1
RELAY_WEBHOOK_PORT=8791
RELAY_WEBHOOK_PATH=/relay/webhook
RELAY_REPLAY_WINDOW_S=300
# Optional outbound access — ONLY if you exposed an endpoint yourself:
RELAY_BASE_URL=
RELAY_API_TOKEN=
RELAY_REQUEST_TIMEOUT_SECONDS=10
RELAY_MAX_RETRIES=2
# Mutating Relay actions stay off unless you explicitly opt in:
RELAY_ALLOW_ACTIONS=1

# ── Voice pipeline watchdogs (Fase 1-2) ──────────────────────────────────────
JARVIS_TOOL_TIMEOUT_S=60
JARVIS_RESPONSE_TIMEOUT_S=30
JARVIS_MAX_SPEAK_S=120

# ── Double-clap wake trigger (Fase 3) ────────────────────────────────────────
CLAP_ENABLED=1
# CLAP_INPUT_DEVICE=            # PyAudio device index; empty = default mic
CLAP_SAMPLE_RATE=16000
CLAP_THRESHOLD_MULTIPLIER=6.0
CLAP_MIN_INTERVAL_MS=120
CLAP_MAX_INTERVAL_MS=900
CLAP_COOLDOWN_MS=2500
CLAP_CALIBRATION_SECONDS=1.5

# ── Email briefing (moved out of config.yaml — Fase 6 secrets cleanup) ───────
JARVIS_IMAP_HOST=imap.gmail.com
JARVIS_IMAP_USER=
JARVIS_IMAP_PASSWORD=

# ── MK50 Agent native (jarvis/agent) ─────────────────────────────────────────
# API key provider juga bisa diisi lewat Settings (ikon gear) di UI.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OpenRouter — kandidat fallback lane berat (config.yaml: routing.heavy).
OPENROUTER_API_KEY=
# Local OpenAI-compatible (LM Studio / Ollama / llama.cpp / vLLM):
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=

# Telegram Control diatur dari Settings → Messaging. Token dan Allowed User
# IDs hanya disimpan oleh jarvis.core.secrets_store, bukan di .env/config.yaml.

# Home Assistant (opsional)
HA_URL=
HA_TOKEN=

# Spotify (opsional, OAuth PKCE)
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
